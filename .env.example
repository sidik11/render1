# Server 1 - Core/Admin API
# Local development only; on Render, the platform PORT variable takes precedence.
SERVER1_PORT=3000
# Local development target. On Render, set this to Server 2's exact HTTPS service URL.
SERVER2_URL=http://127.0.0.1:3001
NODE_ENV=development
# Set to the exact deployed Vercel origin in production.
FRONTEND_ORIGIN=https://your-project.vercel.app

# Server 1 Firebase RTDB
SERVER1_FIREBASE_PROJECT_ID=
SERVER1_FIREBASE_CLIENT_EMAIL=
SERVER1_FIREBASE_PRIVATE_KEY=
SERVER1_FIREBASE_DATABASE_URL=

# Shared service-to-service secret: same value on both Render services, at least 32 random characters.
INTERNAL_AUTH_SECRET=

# Manual authentication / sessions: AUTH_SESSION_SECRET must match on both services in production.
AUTH_SESSION_SECRET=
ADMIN_OTP_SECRET=
ADMIN_NAME=Administrator

# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Legacy payment variables retained for compatibility
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_GATEWAY=0
